    thread_safe_setters: ''
    title: QPSKsender(ExcessBandwidth)
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: bitDelay
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: tabi
    label: Bit Delay
    min_len: '200'
