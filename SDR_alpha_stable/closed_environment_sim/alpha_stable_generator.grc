- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: |-
      import sys
      from pathlib import Path

      _PROJECT_DIR = str(Path(__file__).resolve().parent.parent)
      if _PROJECT_DIR not in sys.path:
          sys.path.insert(0, _PROJECT_DIR)

      from sender.alpha_stable_generator_epy_block_0 import alpha_encoder
    affinity: ''
    alias: ''
    alpha_map: alpha_map
    beta_map: beta_map
    comment: ''
    encode_alpha: 'False'
    encode_beta: 'True'
    encode_gama: 'False'
    expected_input_bytes: source_number_of_samples
    gama_map: gama_map
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_symbol: samples_per_symbol
    sync_symbols: '32'
  states:
    _io_cache: ('alpha_encoder', 'alpha_encoder', [('alpha_map', '[1.2, 1.4, 1.6,
      1.8]'), ('beta_map', '[-1.0, 1.0]'), ('gama_map', '[0.5, 1.0, 1.5, 2.0]'), ('samples_per_symbol',
      '500'), ('encode_alpha', 'False'), ('encode_beta', 'True'), ('encode_gama',
      'False'), ('expected_input_bytes', 'None'), ('sync_symbols', '16')], [('0',
      'byte', 1)], [('0', 'complex', 1)], '', ['alpha_map', 'beta_map', 'encode_alpha',
